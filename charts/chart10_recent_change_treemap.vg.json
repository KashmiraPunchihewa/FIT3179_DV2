{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 800,
  "height": 360,
  "padding": 8,
  "autosize": "pad",
  "background": "transparent",
  "data": [
    {
      "name": "tree",
      "url": "data/industry_composition.json",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "squarify",
          "ratio": 1.4,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 2,
          "paddingOuter": 0
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "shareColour",
      "type": "linear",
      "domain": [
        0,
        0.25
      ],
      "range": {
        "scheme": "blues"
      },
      "zero": true
    }
  ],
  "legends": [
    {
      "fill": "shareColour",
      "title": "Share of national insolvencies (%)",
      "format": ".0%",
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 220,
      "titleLimit": 310
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "shareColour",
            "field": "share"
          },
          "stroke": {
            "value": "white"
          },
          "tooltip": {
            "signal": "{'Industry':datum.id,'2025\u201326 insolvencies':format(datum.value,','),'Share of national total':format(datum.share,'.1%')}"
          },
          "fillOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+7"
          },
          "y": {
            "signal": "datum.y0+17"
          },
          "text": {
            "field": "id"
          },
          "limit": {
            "signal": "max(0,datum.x1-datum.x0-14)"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "signal": "datum.share >= 0.13 ? 'white' : '#172033'"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0 > 85 && datum.y1-datum.y0 > 40 ? 1 : 0"
          },
          "tooltip": {
            "signal": "{'Industry':datum.id,'2025\u201326 insolvencies':format(datum.value,','),'Share of national total':format(datum.share,'.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0+7"
          },
          "y": {
            "signal": "datum.y0+34"
          },
          "text": {
            "signal": "format(datum.share,'.1%') + ' \u00b7 ' + format(datum.value,',')"
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "datum.share >= 0.13 ? 'white' : '#172033'"
          },
          "opacity": {
            "signal": "datum.x1-datum.x0 > 100 && datum.y1-datum.y0 > 40 ? 1 : 0"
          },
          "tooltip": {
            "signal": "{'Industry':datum.id,'2025\u201326 insolvencies':format(datum.value,','),'Share of national total':format(datum.share,'.1%')}"
          }
        }
      }
    }
  ]
}
