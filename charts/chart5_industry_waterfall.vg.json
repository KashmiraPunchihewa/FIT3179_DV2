{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 720,
  "height": 430,
  "title": {
    "text": "Which Industries Drove the Rise in Formal Insolvencies?",
    "subtitle": "Contribution to the increase from 2022–23 to 2025–26; 'Other industries' combines all remaining industries",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitlePadding": 8
  },
  "data": {
    "url": "https://raw.githubusercontent.com/KashmiraPunchihewa/FIT3179_DV2/main/data/asic_series1_industry_year.csv"
  },
  "transform": [
    {
      "filter": "datum.financial_year === '2022-2023' || datum.financial_year === '2025-2026'"
    },
    {"calculate": "toNumber(datum.insolvencies)", "as": "insolvencies_num"},
    {
      "pivot": "financial_year",
      "value": "insolvencies_num",
      "groupby": ["industry"]
    },
    {"calculate": "datum['2025-2026'] - datum['2022-2023']", "as": "change"},
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "change", "order": "descending"}]
    },
    {
      "calculate": "datum.rank <= 7 && datum.industry !== 'Unknown' ? datum.industry : 'Other industries'",
      "as": "category"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "change", "as": "change"},
        {"op": "sum", "field": "2022-2023", "as": "count_2022"},
        {"op": "sum", "field": "2025-2026", "as": "count_2025"},
        {"op": "min", "field": "rank", "as": "sort_order"}
      ],
      "groupby": ["category"]
    },
    {
      "calculate": "datum.category === 'Accommodation and Food Services' ? 'Accommodation & Food' : datum.category === 'Professional, Scientific and Technical Services' ? 'Professional & Technical' : datum.category === 'Transport, Postal and Warehousing' ? 'Transport & Warehousing' : datum.category === 'Administrative and Support Services' ? 'Administrative Support' : datum.category",
      "as": "display_category"
    },
    {
      "window": [{"op": "sum", "field": "change", "as": "cumulative"}],
      "sort": [{"field": "sort_order", "order": "ascending"}]
    },
    {"calculate": "datum.cumulative - datum.change", "as": "start_value"},
    {"calculate": "datum.cumulative", "as": "end_value"},
    {
      "calculate": "datum.change >= 0 ? '+' + format(datum.change, ',.0f') : format(datum.change, ',.0f')",
      "as": "change_label"
    }
  ],
  "layer": [
    {
      "mark": {"type": "bar", "size": 55, "color": "#3182bd"},
      "encoding": {
        "x": {
          "field": "display_category",
          "type": "nominal",
          "sort": {"field": "sort_order", "order": "ascending"},
          "title": null,
          "axis": {
            "labelAngle": -30,
            "labelFontSize": 11,
            "labelLimit": 150,
            "labelPadding": 8
          }
        },
        "y": {
          "field": "start_value",
          "type": "quantitative",
          "title": "Cumulative change in formal insolvencies",
          "axis": {"format": ",.0f"}
        },
        "y2": {"field": "end_value"},
        "tooltip": [
          {"field": "category", "type": "nominal", "title": "Industry"},
          {
            "field": "count_2022",
            "type": "quantitative",
            "title": "2022–23 insolvencies",
            "format": ",.0f"
          },
          {
            "field": "count_2025",
            "type": "quantitative",
            "title": "2025–26 insolvencies",
            "format": ",.0f"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change",
            "format": "+,.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "display_category",
          "type": "nominal",
          "sort": {"field": "sort_order", "order": "ascending"}
        },
        "y": {"field": "end_value", "type": "quantitative"},
        "text": {"field": "change_label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e5e5e5",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10
    }
  }
}