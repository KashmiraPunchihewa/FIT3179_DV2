{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 370,
  "padding": 8,
  "data": {
    "url": "data/industry_waterfall.json"
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "isValid(datum.next)"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9ba5ad",
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "y": {
          "field": "display",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11
          }
        },
        "y2": {
          "field": "next"
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "size": 22
      },
      "encoding": {
        "y": {
          "field": "display",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "start",
          "type": "quantitative",
          "title": "Companies entering insolvency",
          "scale": {
            "domain": [
              0,
              16000
            ]
          },
          "axis": {
            "format": "~s",
            "tickCount": 5
          }
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "scale": {
            "domain": [
              "Total",
              "Increase",
              "Decrease"
            ],
            "range": [
              "#172033",
              "#287d9a",
              "#d18130"
            ]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "values": [
              "Total",
              "Increase"
            ]
          }
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Component"
          },
          {
            "field": "amount",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Total / change"
          },
          {
            "field": "count_start",
            "type": "quantitative",
            "format": ",.0f",
            "title": "2022\u201323"
          },
          {
            "field": "count_end",
            "type": "quantitative",
            "format": ",.0f",
            "title": "2025\u201326"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "y": {
          "field": "display",
          "type": "ordinal",
          "sort": {
            "field": "order"
          },
          "title": null,
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e5e5e5",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10
    },
    "font": "Inter",
    "background": "transparent"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "transform": [
    {
      "calculate": "datum.kind === 'Total' ? datum.amount : datum.count_end - datum.count_start",
      "as": "amount"
    },
    {
      "calculate": "datum.kind === 'Total' && datum.order > 0 ? 0 : datum.amount",
      "as": "increment"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "increment",
          "as": "running_total"
        },
        {
          "op": "lead",
          "field": "display",
          "as": "next"
        }
      ],
      "sort": [
        {
          "field": "order",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.kind === 'Total' ? 0 : datum.running_total - datum.amount",
      "as": "start"
    },
    {
      "calculate": "datum.running_total",
      "as": "end"
    },
    {
      "calculate": "datum.kind === 'Total' ? format(datum.end, ',.0f') : format(datum.amount, '+,.0f')",
      "as": "label"
    }
  ]
}
