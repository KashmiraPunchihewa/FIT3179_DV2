{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 300,
  "padding": 10,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "data": {
    "url": "data/industry_waterfall.json"
  },
  "transform": [
    {
      "filter": "datum.kind !== 'Total'"
    },
    {
      "calculate": "datum.count_end - datum.count_start",
      "as": "amount"
    },
    {
      "calculate": "datum.amount / 6211",
      "as": "share"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e5e5e5",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 16,
      "labelPadding": 9
    },
    "font": "Inter",
    "background": "transparent"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 23
      },
      "encoding": {
        "x": {
          "field": "amount",
          "type": "quantitative",
          "title": "Additional companies \u00b7 2025\u201326 minus 2022\u201323",
          "scale": {
            "domain": [
              0,
              1700
            ]
          },
          "axis": {
            "format": ",d",
            "tickCount": 5
          }
        },
        "y": {
          "field": "display",
          "type": "nominal",
          "sort": {
            "field": "amount",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 190,
            "labelPadding": 10,
            "labelFontSize": 11
          }
        },
        "color": {
          "condition": {
            "test": "datum.category === 'All remaining industries'",
            "value": "#8895a0"
          },
          "value": "#287d9a"
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Industry / group"
          },
          {
            "field": "count_start",
            "title": "2022\u201323",
            "format": ",d"
          },
          {
            "field": "count_end",
            "title": "2025\u201326",
            "format": ",d"
          },
          {
            "field": "amount",
            "title": "Additional companies",
            "format": "+,"
          },
          {
            "field": "share",
            "title": "Share of national increase",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontWeight": "bold",
        "fontSize": 11
      },
      "encoding": {
        "x": {
          "field": "amount",
          "type": "quantitative",
          "title": "Additional companies \u00b7 2025\u201326 minus 2022\u201323",
          "scale": {
            "domain": [
              0,
              1700
            ]
          },
          "axis": {
            "format": ",d",
            "tickCount": 5
          }
        },
        "y": {
          "field": "display",
          "type": "nominal",
          "sort": {
            "field": "amount",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 190,
            "labelPadding": 10,
            "labelFontSize": 11
          }
        },
        "text": {
          "field": "amount",
          "format": "+,"
        },
        "tooltip": [
          {
            "field": "category",
            "title": "Industry / group"
          },
          {
            "field": "count_start",
            "title": "2022\u201323",
            "format": ",d"
          },
          {
            "field": "count_end",
            "title": "2025\u201326",
            "format": ",d"
          },
          {
            "field": "amount",
            "title": "Additional companies",
            "format": "+,"
          },
          {
            "field": "share",
            "title": "Share of national increase",
            "format": ".1%"
          }
        ]
      }
    }
  ]
}
