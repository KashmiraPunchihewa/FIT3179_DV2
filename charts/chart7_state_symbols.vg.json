{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 760,
  "height": 520,

  "title": {
    "text": "Where Were Formal Insolvencies Concentrated in 2025–26?",
    "subtitle": "Companies entering external administration for the first time",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "anchor": "start",
    "offset": 10
  },

  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 850
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KashmiraPunchihewa/FIT3179_DV2/main/data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#f1f3f5",
        "stroke": "#9aa4af",
        "strokeWidth": 1.2
      },

      "encoding": {
        "shape": {
          "field": "geometry",
          "type": "geojson"
        },
        "tooltip": [
          {
            "field": "properties.state_name_2021",
            "type": "nominal",
            "title": "State / Territory"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/KashmiraPunchihewa/FIT3179_DV2/main/data/asic_state_insolvencies_2025_26.csv"
      },

      "mark": {
        "type": "point",
        "filled": true,
        "color": "#377eb8",
        "opacity": 0.82,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "insolvencies",
          "type": "quantitative",
          "title": "Formal insolvencies",
          "scale": {
            "domain": [0, 5500],
            "range": [80, 2800]
          },
          "legend": {
            "values": [100, 1000, 2500, 5000],
            "format": ","
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "title": "Formal insolvencies",
            "format": ","
          }
        ]
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold"
    },

    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    }
  }
}
