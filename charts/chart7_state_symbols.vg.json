{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 410,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -134,
      0,
      0
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "bold"
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    },
    "font": "Inter"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8,
  "layer": [
    {
      "data": {
        "url": "data/australia_states_abs2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.state_code_2021 !== 'Z'"
        },
        {
          "lookup": "properties.state_name_2021",
          "from": {
            "data": {
              "url": "data/state_insolvency_comparison.csv"
            },
            "key": "state",
            "fields": [
              "insolvencies",
              "operating_start",
              "per_10000_businesses"
            ]
          }
        },
        {
          "calculate": "datum.insolvencies / datum.operating_start * 10000",
          "as": "per_10000_businesses"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.3
      },
      "encoding": {
        "color": {
          "field": "per_10000_businesses",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              75
            ],
            "scheme": "blues"
          },
          "title": "Per 10,000 businesses",
          "legend": {
            "orient": "bottom",
            "gradientLength": 230,
            "titleLimit": 280
          }
        },
        "tooltip": [
          {
            "field": "properties.state_name_2021",
            "title": "State / territory"
          },
          {
            "field": "per_10000_businesses",
            "type": "quantitative",
            "format": ".1f",
            "title": "Per 10,000 businesses"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Insolvencies"
          },
          {
            "field": "operating_start",
            "type": "quantitative",
            "format": ",.0f",
            "title": "ABS businesses at 1 July 2025"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_insolvency_comparison.csv"
      },
      "transform": [
        {
          "calculate": "datum.insolvencies / datum.operating_start * 10000",
          "as": "per_10000_businesses"
        },
        {
          "calculate": "datum.state === 'New South Wales' ? 'NSW' : datum.state === 'Victoria' ? 'VIC' : datum.state === 'Queensland' ? 'QLD' : datum.state === 'South Australia' ? 'SA' : datum.state === 'Western Australia' ? 'WA' : datum.state === 'Tasmania' ? 'TAS' : datum.state === 'Northern Territory' ? 'NT' : 'ACT'",
          "as": "abbr"
        },
        {
          "filter": "datum.abbr !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr"
        },
        "color": {
          "condition": {
            "test": "datum.per_10000_businesses > 45",
            "value": "white"
          },
          "value": "#172033"
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "per_10000_businesses",
            "format": ".1f",
            "title": "Per 10,000 businesses"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
