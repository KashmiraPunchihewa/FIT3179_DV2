{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": {
    "step": 29
  },
  "data": {
    "url": "data/asic_series1_industry_year.csv"
  },
  "transform": [
    {
      "filter": "datum.industry !== 'Unknown'"
    },
    {
      "calculate": "datum.industry === \"Accommodation and Food Services\" ? \"Accommodation & food\" : datum.industry === \"Administrative and Support Services\" ? \"Administrative support\" : datum.industry === \"Agriculture, Forestry and Fishing\" ? \"Agriculture & fishing\" : datum.industry === \"Arts and Recreation Services\" ? \"Arts & recreation\" : datum.industry === \"Electricity, Gas, Water and Waste Services\" ? \"Utilities & waste\" : datum.industry === \"Financial and Insurance Services\" ? \"Finance & insurance\" : datum.industry === \"Health Care and Social Assistance\" ? \"Health & social care\" : datum.industry === \"Information Media and Telecommunications\" ? \"Media & telecoms\" : datum.industry === \"Professional, Scientific and Technical Services\" ? \"Professional & technical\" : datum.industry === \"Public Administration and Safety\" ? \"Public administration\" : datum.industry === \"Rental, Hiring and Real Estate Services\" ? \"Rental & real estate\" : datum.industry === \"Transport, Postal and Warehousing\" ? \"Transport & warehousing\" : datum.industry",
      "as": "display_industry"
    },
    {
      "calculate": "datum.financial_year === '2025-2026' ? toNumber(datum.insolvencies) : 0",
      "as": "latest"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "latest",
          "as": "latest_count"
        }
      ],
      "groupby": [
        "industry"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "latest_rank"
        }
      ],
      "sort": [
        {
          "field": "latest_count",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "industryCoverage === 'All industries' || datum.latest_rank <= 10"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-2022",
            "2022-2023",
            "2023-2024",
            "2024-2025",
            "2025-2026"
          ],
          "title": "Financial year",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 0, 4) + '\u2013' + slice(datum.label, -2)",
            "labelFontSize": 12,
            "titleFontSize": 13,
            "titlePadding": 10
          }
        },
        "y": {
          "field": "display_industry",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "latest_count",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 180
          }
        },
        "color": {
          "field": "insolvencies",
          "type": "quantitative",
          "title": "Formal insolvencies",
          "scale": {
            "domain": [
              0,
              3600
            ],
            "scheme": "blues"
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "industry",
            "type": "nominal",
            "title": "Industry"
          },
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "title": "Formal insolvencies",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-2022",
            "2022-2023",
            "2023-2024",
            "2024-2025",
            "2025-2026"
          ]
        },
        "y": {
          "field": "display_industry",
          "type": "nominal",
          "sort": {
            "field": "latest_count",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelFontSize": 11,
            "labelLimit": 180
          }
        },
        "text": {
          "field": "insolvencies",
          "type": "quantitative",
          "format": ",.0f"
        },
        "color": {
          "condition": {
            "test": "datum.insolvencies >= 1800",
            "value": "white"
          },
          "value": "#172033"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 0
    },
    "legend": {
      "labelLimit": 160
    },
    "font": "Inter",
    "background": "transparent"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8,
  "params": [
    {
      "name": "industryCoverage",
      "value": "Top 10",
      "bind": {
        "input": "select",
        "options": [
          "Top 10",
          "All industries"
        ],
        "name": "Industries shown: "
      }
    }
  ]
}
