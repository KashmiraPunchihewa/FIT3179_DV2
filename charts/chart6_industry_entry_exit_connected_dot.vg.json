{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": {
    "step": 27
  },
  "data": {
    "url": "data/abs_industry_entry_exit_rates.csv"
  },
  "transform": [
    {
      "filter": "datum.financial_year === '2025-26'"
    },
    {
      "calculate": "toNumber(datum.entry_rate)",
      "as": "entry"
    },
    {
      "calculate": "toNumber(datum.exit_rate)",
      "as": "exit"
    },
    {
      "calculate": "datum.industry === \"Accommodation and Food Services\" ? \"Accommodation & food\" : datum.industry === \"Administrative and Support Services\" ? \"Administrative support\" : datum.industry === \"Agriculture, Forestry and Fishing\" ? \"Agriculture & fishing\" : datum.industry === \"Arts and Recreation Services\" ? \"Arts & recreation\" : datum.industry === \"Electricity, Gas, Water and Waste Services\" ? \"Utilities & waste\" : datum.industry === \"Financial and Insurance Services\" ? \"Finance & insurance\" : datum.industry === \"Health Care and Social Assistance\" ? \"Health & social care\" : datum.industry === \"Information Media and Telecommunications\" ? \"Media & telecoms\" : datum.industry === \"Professional, Scientific and Technical Services\" ? \"Professional & technical\" : datum.industry === \"Public Administration and Safety\" ? \"Public administration\" : datum.industry === \"Rental, Hiring and Real Estate Services\" ? \"Rental & real estate\" : datum.industry === \"Transport, Postal and Warehousing\" ? \"Transport & warehousing\" : datum.industry",
      "as": "display_industry"
    },
    {
      "calculate": "round((datum.entry-datum.exit)*10)/10",
      "as": "gap"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "color": "#8a99a6"
      },
      "encoding": {
        "y": {
          "field": "display_industry",
          "type": "nominal",
          "sort": {
            "field": "gap",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11,
            "labelPadding": 10
          }
        },
        "x": {
          "field": "exit",
          "type": "quantitative",
          "title": "Business rate (%)",
          "scale": {
            "domain": [
              0,
              37
            ],
            "zero": true
          },
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20,
              25,
              30
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "x2": {
          "field": "entry"
        },
        "tooltip": [
          {
            "field": "industry",
            "title": "Industry"
          },
          {
            "field": "entry",
            "title": "Entry rate (%)",
            "format": ".1f"
          },
          {
            "field": "exit",
            "title": "Exit rate (%)",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Entry minus exit (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "entry",
            "exit"
          ],
          "as": [
            "rate_type",
            "rate"
          ]
        },
        {
          "calculate": "datum.rate_type === 'entry' ? 'Entry rate' : 'Exit rate'",
          "as": "Rate type"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 115,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "display_industry",
          "type": "nominal",
          "sort": {
            "field": "gap",
            "order": "descending"
          },
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11,
            "labelPadding": 10
          }
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              37
            ],
            "zero": true
          }
        },
        "color": {
          "field": "Rate type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Entry rate",
              "Exit rate"
            ],
            "range": [
              "#2F6B9A",
              "#C95A49"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "industry",
            "title": "Industry"
          },
          {
            "field": "entry",
            "title": "Entry rate (%)",
            "format": ".1f"
          },
          {
            "field": "exit",
            "title": "Exit rate (%)",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Entry minus exit (percentage points)",
            "format": "+.1f"
          }
        ],
        "shape": {
          "field": "Rate type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Entry rate",
              "Exit rate"
            ],
            "range": [
              "circle",
              "cross"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null
          }
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.gap,'+.1f') + ' pp'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 0,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#172033",
        "dy": 0
      },
      "encoding": {
        "y": {
          "field": "display_industry",
          "type": "nominal",
          "sort": {
            "field": "gap",
            "order": "descending"
          },
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11,
            "labelPadding": 10
          }
        },
        "x": {
          "datum": 33,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              37
            ]
          }
        },
        "text": {
          "field": "label"
        },
        "tooltip": [
          {
            "field": "industry",
            "title": "Industry"
          },
          {
            "field": "entry",
            "title": "Entry rate (%)",
            "format": ".1f"
          },
          {
            "field": "exit",
            "title": "Exit rate (%)",
            "format": ".1f"
          },
          {
            "field": "gap",
            "title": "Entry minus exit (percentage points)",
            "format": "+.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 0,
      "gridColor": "#e5e5e5",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 16
    },
    "legend": {
      "symbolType": "circle",
      "symbolSize": 100
    },
    "font": "Inter",
    "background": "transparent"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8
}
