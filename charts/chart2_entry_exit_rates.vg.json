{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 230,
  "data": {
    "url": "data/abs_national_entry_exit_rates.csv"
  },
  "transform": [
    {
      "fold": [
        "entry_rate",
        "exit_rate"
      ],
      "as": [
        "rate_type",
        "rate"
      ]
    },
    {
      "calculate": "datum.rate_type === 'entry_rate' ? 'Entry rate' : 'Exit rate'",
      "as": "Rate type"
    },
    {
      "calculate": "datum['Rate type'] + ': ' + format(datum.rate, '.1f') + '%'",
      "as": "direct_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2022-23",
            "2023-24",
            "2024-25",
            "2025-26"
          ],
          "title": "Financial year",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 0, 4) + '\u2013' + slice(datum.label, -2)"
          }
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "title": "Rate (%)",
          "scale": {
            "zero": true,
            "domain": [
              0,
              20
            ]
          },
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "color": {
          "field": "Rate type",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Entry rate",
              "Exit rate"
            ],
            "range": [
              "#2F6B9A",
              "#C95A49"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "Rate type",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2022-23",
            "2023-24",
            "2024-25",
            "2025-26"
          ]
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              20
            ]
          }
        },
        "color": {
          "field": "Rate type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Entry rate",
              "Exit rate"
            ],
            "range": [
              "#2F6B9A",
              "#C95A49"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "Rate type",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.financial_year === '2025-26'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 12,
        "fontWeight": "bold",
        "dy": {
          "expr": "datum.rate_type === 'entry_rate' ? -15 : 18"
        }
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2022-23",
            "2023-24",
            "2024-25",
            "2025-26"
          ]
        },
        "y": {
          "field": "rate",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              20
            ]
          }
        },
        "color": {
          "field": "Rate type",
          "type": "nominal",
          "scale": {
            "domain": [
              "Entry rate",
              "Exit rate"
            ],
            "range": [
              "#2F6B9A",
              "#C95A49"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null
          }
        },
        "text": {
          "field": "direct_label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#dddddd",
      "gridOpacity": 0.5,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 16,
      "labelPadding": 8
    },
    "legend": {
      "labelFontSize": 12
    },
    "font": "Inter",
    "background": "transparent"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8,
  "title": {
    "text": "2025\u201326 gap: 3.1 percentage points",
    "anchor": "start",
    "fontSize": 13,
    "fontWeight": "normal",
    "offset": 15
  }
}
