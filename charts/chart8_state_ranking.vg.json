{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/asic_state_insolvencies_2025_26.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "color": "#377eb8",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "Western Australia",
            "South Australia",
            "Australian Capital Territory",
            "Tasmania",
            "Northern Territory"
          ],
          "title": null,
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "insolvencies",
          "type": "quantitative",
          "title": "Formal insolvencies",
          "scale": {
            "domain": [
              0,
              5600
            ]
          },
          "axis": {
            "values": [
              0,
              1000,
              2000,
              3000,
              4000,
              5000
            ],
            "format": ",.0f",
            "labelFontSize": 11,
            "titleFontSize": 12,
            "grid": true,
            "gridOpacity": 0.2,
            "tickSize": 4
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "title": "Formal insolvencies",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#374151"
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "New South Wales",
            "Victoria",
            "Queensland",
            "Western Australia",
            "South Australia",
            "Australian Capital Territory",
            "Tasmania",
            "Northern Territory"
          ],
          "axis": {
            "labelLimit": 180,
            "labelFontSize": 11
          }
        },
        "x": {
          "field": "insolvencies",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              5600
            ]
          }
        },
        "text": {
          "field": "insolvencies",
          "type": "quantitative",
          "format": ",.0f"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "title": {
      "font": "Arial",
      "subtitleFont": "Arial"
    },
    "font": "Inter"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8
}
