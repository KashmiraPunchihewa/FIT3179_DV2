{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 10,
  "config": {
    "font": "Inter",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "tickSize": 0,
      "labelPadding": 9,
      "titlePadding": 16,
      "gridColor": "#e5e5e5"
    }
  },
  "height": 300,
  "data": {
    "url": "data/state_change.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 20
      },
      "encoding": {
        "x": {
          "field": "change",
          "type": "quantitative",
          "title": "Change in companies \u00b7 2024\u201325 to 2025\u201326",
          "scale": {
            "domain": [
              -400,
              90
            ]
          },
          "axis": {
            "format": "+d",
            "tickCount": 5
          }
        },
        "y": {
          "field": "abbr",
          "type": "nominal",
          "sort": {
            "field": "change",
            "order": "ascending"
          },
          "title": null
        },
        "color": {
          "condition": {
            "test": "datum.change < 0",
            "value": "#d18130"
          },
          "value": "#287d9a"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "previous",
            "title": "2024\u201325",
            "format": ","
          },
          {
            "field": "insolvencies",
            "title": "2025\u201326",
            "format": ","
          },
          {
            "field": "change",
            "title": "Change",
            "format": "+,"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#172033"
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": {
          "expr": "datum.change < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.change < 0 ? -6 : 6"
        },
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "change",
          "type": "quantitative",
          "title": "Change in companies \u00b7 2024\u201325 to 2025\u201326",
          "scale": {
            "domain": [
              -400,
              90
            ]
          },
          "axis": {
            "format": "+d",
            "tickCount": 5
          }
        },
        "y": {
          "field": "abbr",
          "type": "nominal",
          "sort": {
            "field": "change",
            "order": "ascending"
          },
          "title": null
        },
        "text": {
          "field": "change",
          "format": "+,"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "previous",
            "title": "2024\u201325",
            "format": ","
          },
          {
            "field": "insolvencies",
            "title": "2025\u201326",
            "format": ","
          },
          {
            "field": "change",
            "title": "Change",
            "format": "+,"
          }
        ]
      }
    }
  ]
}
