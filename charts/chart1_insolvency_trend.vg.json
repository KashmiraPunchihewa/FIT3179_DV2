{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/asic_series1_annual.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#b45138"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-2022",
            "2022-2023",
            "2023-2024",
            "2024-2025",
            "2025-2026"
          ],
          "title": "Financial year",
          "axis": {
            "labelAngle": 0,
            "labelExpr": "slice(datum.label, 0, 4) + '\u2013' + slice(datum.label, -2)"
          }
        },
        "y": {
          "field": "insolvencies",
          "type": "quantitative",
          "title": "Companies (ASIC Series 1)",
          "scale": {
            "zero": true,
            "domain": [
              0,
              16000
            ]
          },
          "axis": {
            "values": [
              0,
              2000,
              4000,
              6000,
              8000,
              10000,
              12000,
              14000,
              16000
            ],
            "labelExpr": "format(datum.value, ',.0f')"
          }
        },
        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "title": "Insolvencies",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "color": "#b45138"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-2022",
            "2022-2023",
            "2023-2024",
            "2024-2025",
            "2025-2026"
          ]
        },
        "y": {
          "field": "insolvencies",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              16000
            ]
          }
        },
        "tooltip": [
          {
            "field": "financial_year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "insolvencies",
            "type": "quantitative",
            "title": "Insolvencies",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.financial_year === '2024-2025'"
        },
        {
          "calculate": "'Peak: ' + format(datum.insolvencies, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -12,
        "fontWeight": "bold",
        "fontSize": 13,
        "color": "#b45138"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2021-2022",
            "2022-2023",
            "2023-2024",
            "2024-2025",
            "2025-2026"
          ]
        },
        "y": {
          "field": "insolvencies",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "domain": [
              0,
              16000
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#dddddd",
      "gridOpacity": 0.5,
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10
    },
    "font": "Inter",
    "background": "transparent"
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "padding": 8
}
